# Copia este archivo como ".env" (sin ".example") dentro de la carpeta servidor y rellena los valores.
# El .env NO se sube a GitHub: cada persona del grupo tiene el suyo (se pasan por privado, nunca por el repo).

PORT=3000

# Clave para firmar los tokens. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Base de datos (Aiven). La contraseña está en el panel de Aiven.
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=miapp-miapp.b.aivencloud.com
DB_PORT=27199
